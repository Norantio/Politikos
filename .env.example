# --- civicAPI ---
CIVICAPI_BASE_URL=https://civicapi.org/api/v2
CIVICAPI_USER_AGENT=politikos/0.1 (+https://github.com/Norantio/Politikos)

# --- Postgres ---
POSTGRES_USER=politikos
POSTGRES_PASSWORD=politikos
POSTGRES_DB=politikos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Poller cadences (seconds) ---
POLLER_LIVE_INTERVAL=20
POLLER_ELECTION_DAY_IDLE_INTERVAL=120
POLLER_UPCOMING_INTERVAL=3600
POLLER_HISTORICAL_INTERVAL=86400

# --- API ---
API_HOST=0.0.0.0
API_PORT=8090
API_CORS_ORIGINS=http://localhost:5173

# --- v1 scope ---
COUNTRY_FILTER=US
